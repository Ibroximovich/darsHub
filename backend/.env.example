# =============================================
# DarsHub Backend — Environment Variables Example
# =============================================

# PostgreSQL ulanish URL'i
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/darshub?schema=public"

# JWT kalitlari
JWT_SECRET="your_jwt_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"

# Resend API kaliti (https://resend.com dan oling)
RESEND_API_KEY="re_your_resend_api_key_here"

# Resend orqali yuboriladigan email manzili
RESEND_FROM_EMAIL="DarsHub <onboarding@resend.dev>"

# Server port
PORT=5000

# Node muhiti
NODE_ENV=development
