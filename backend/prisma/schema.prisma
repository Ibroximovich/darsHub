// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String
  passwordHash String
  isVerified   Boolean  @default(false)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groups Group[]
  students Student[]

  @@map("users")
}

model Group {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  days            String[] // masalan: ["monday", "wednesday", "friday"]
  time            String   // masalan: "15:00"
  price           Int      // so'mda, masalan 500000
  paymentType     String   // "monthly" yoki "lesson_based"
  lessonsPerCycle Int?     // faqat paymentType = "lesson_based" bo'lsa qiymat oladi
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  studentLinks    GroupStudent[]
  lessons         Lesson[]

  @@map("groups")
}

model Student {
  id          String         @id @default(uuid())
  userId      String         // bu o'quvchini birinchi marta qo'shgan repetitor
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  phone       String
  parentName  String?        // IXTIYORIY — ota-ona ismi kiritilmasligi mumkin
  parentPhone String         // MAJBURIY — ota-ona telefon raqami
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  groupLinks  GroupStudent[]

  @@map("students")
}

model GroupStudent {
  id          String       @id @default(uuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      String       @default("active") // "active" yoki "stopped"
  joinedAt    DateTime     @default(now())
  stoppedAt   DateTime?
  attendances Attendance[]
  payments    Payment[]

  @@unique([groupId, studentId]) // bitta o'quvchi bitta guruhga faqat bir marta biriktirilishi mumkin
  @@map("group_students")
}

model Payment {
  id             String       @id @default(uuid())
  groupStudentId String
  groupStudent   GroupStudent @relation(fields: [groupStudentId], references: [id], onDelete: Cascade)
  period         String       // monthly uchun "2026-07", lesson_based uchun "cycle-1", "cycle-2" kabi
  amount         Int          // so'mda, masalan 500000
  status         String       @default("unpaid") // "paid" yoki "unpaid"
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([groupStudentId, period]) // bitta o'quvchi + bitta davr uchun faqat bitta to'lov yozuvi
  @@map("payments")
}

model Lesson {
  id          String       @id @default(uuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  status      String       // "held" yoki "cancelled"
  createdAt   DateTime     @default(now())
  attendances Attendance[]

  @@unique([groupId, date]) // bir guruhda bir kunga faqat bitta dars yozuvi bo'lishi mumkin
  @@map("lessons")
}

model Attendance {
  id             String       @id @default(uuid())
  lessonId       String
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  groupStudentId String
  groupStudent   GroupStudent @relation(fields: [groupStudentId], references: [id], onDelete: Cascade)
  present        Boolean
  markedAt       DateTime     @default(now())

  @@unique([lessonId, groupStudentId]) // bir o'quvchiga bir darsda faqat bitta davomat yozuvi
  @@map("attendances")
}

model EmailVerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_codes")
}

model PasswordResetCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_codes")
}
